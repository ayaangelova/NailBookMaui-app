<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NailBookMaui.Views.ServicesPage"
             Title="Услуги">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Каталог с услуги" FontSize="28" FontAttributes="Bold" />
            <SearchBar Placeholder="Търси: гел лак, декорация..." Text="{Binding SearchText}" />
            <CollectionView ItemsSource="{Binding Services}" HeightRequest="520">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardFrame}">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}" FontSize="19" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding FormattedPrice}" FontSize="17" FontAttributes="Bold" TextColor="#D96BA0" />
                                </Grid>
                                <Label Text="{Binding SalonDisplayText}" FontSize="13" TextColor="#7A2F54" FontAttributes="Bold" />
                                <Label Text="{Binding Category}" FontSize="13" TextColor="Gray" />
                                <Label Text="{Binding Description}" FontSize="14" />
                                <Label Text="{Binding FormattedDuration}" FontSize="13" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Frame BackgroundColor="#FDEBF3" BorderColor="#D96BA0" CornerRadius="18" Padding="16">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Контакти" FontSize="18" FontAttributes="Bold" TextColor="#7A2F54" />
                    
                    <Label Text="{Binding FooterSalonAddress}" />
                    <Label Text="{Binding FooterSalonPhone}" />
                    <Label Text="{Binding FooterSalonLocation}" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
