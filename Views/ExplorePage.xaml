<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NailBookMaui.Views.ExplorePage"
             Title="Идеи">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Идеи и оферти" FontSize="28" FontAttributes="Bold" />
            <Label Text="Тук потребителят получава допълнително съдържание, което го стимулира да използва приложението отново." FontSize="14" TextColor="Gray" />

            <Label Text="Активни предложения" FontSize="22" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Promotions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardFrame}">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding DiscountText}" FontSize="16" TextColor="#D96BA0" FontAttributes="Bold" />
                                </Grid>
                                <Label Text="{Binding Description}" FontSize="14" />
                                <Label Text="{Binding ValidUntil}" FontSize="13" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Дизайни за вдъхновение" FontSize="22" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Designs}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardFrame}">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding Difficulty}" FontSize="13" TextColor="#7A2F54" FontAttributes="Bold" />
                                </Grid>
                                <Label Text="{Binding Style}" FontSize="14" TextColor="#D96BA0" FontAttributes="Bold" />
                                <Label Text="{Binding Description}" FontSize="14" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Съвети за поддръжка" FontSize="22" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Tips}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardFrame}">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Text}" FontSize="14" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Frame BackgroundColor="#FDEBF3" BorderColor="#D96BA0" CornerRadius="18" Padding="16">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Контакти" FontSize="18" FontAttributes="Bold" TextColor="#7A2F54" />
                   
                    <Label Text="{Binding FooterSalonAddress}" />
                    <Label Text="{Binding FooterSalonPhone}" />
                    <Label Text="{Binding FooterSalonLocation}" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
